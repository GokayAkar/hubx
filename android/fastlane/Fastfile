# Play Store distribution.
#
# The build lanes run anywhere. The upload lane needs a Google Play service
# account JSON (PLAY_STORE_SERVICE_ACCOUNT_JSON) and an app already created in
# the Play Console — neither of which this repository has, so it is wired but
# not exercised. It is written out rather than left to be improvised on the day
# a release is due.
#
# CI does the building today (.github/workflows/release.yml); these lanes exist
# so the same steps can be run from a laptop when something needs to ship while
# the pipeline is unavailable.

default_platform(:android)

platform :android do
  desc "Build the release App Bundle"
  lane :build do |options|
    Dir.chdir("../..") do
      sh(
        "flutter", "build", "appbundle", "--release",
        "--build-name", options[:version] || "0.0.0-dev",
        "--build-number", (options[:build] || "1").to_s
      )
    end
  end

  desc "Build and upload to the internal testing track"
  lane :internal do |options|
    build(options)

    # Internal, not production: it reaches testers within minutes and never
    # touches a real user. Promotion to production stays a human decision made
    # in the console.
    upload_to_play_store(
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "draft"
    )
  end
end
