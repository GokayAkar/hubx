#!/usr/bin/env bash
#
# Runs what CI's `verify` job runs, before anything leaves the machine.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Skip for one push:      git push --no-verify

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

readonly ZERO="0000000000000000000000000000000000000000"

# Git feeds the refs being pushed on stdin. A push that only deletes branches
# has no code to check. Read manually (no stdin) and it runs anyway, which is
# what makes the hook testable by hand.
lines=0
content=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  lines=$((lines + 1))
  [ "${local_sha:-$ZERO}" != "$ZERO" ] && content=1
done
if [ "$lines" -gt 0 ] && [ "$content" -eq 0 ]; then
  exit 0
fi

if ! command -v flutter >/dev/null 2>&1; then
  printf '\npre-push: flutter is not on PATH, so nothing could be verified.\n'
  printf 'Fix the PATH, or push with --no-verify and let CI be the check.\n\n'
  exit 1
fi

failed=""

# run <label> <reproduce> <command...>
run() {
  local label=$1 reproduce=$2
  shift 2

  printf '  %-30s' "$label"
  local output
  if output=$("$@" 2>&1); then
    printf 'ok\n'
    return 0
  fi

  printf 'FAILED\n'
  printf '%s\n' "$output" | sed 's/^/    | /'
  failed=$reproduce
  return 1
}

printf '\npre-push: running the same checks as CI\n\n'

run 'formatting' \
  'dart format lib test tool' \
  dart format --output=none --set-exit-if-changed lib test tool &&
run 'static analysis' \
  'flutter analyze --fatal-infos --fatal-warnings' \
  flutter analyze --fatal-infos --fatal-warnings &&
run 'layer boundaries' \
  'dart run tool/check_layer_deps.dart' \
  dart run tool/check_layer_deps.dart

# Generated code is committed, so it can fall behind its sources. Regenerating
# rewrites files, which would be rude on top of work in progress — and a diff
# in lib/ would then mean "you have unsaved edits", not "the generator is
# behind". So this one is skipped rather than guessed at, and CI, which always
# starts from a clean checkout, remains the real answer.
if [ -z "$failed" ]; then
  if [ -n "$(git status --porcelain -- lib)" ]; then
    printf '  %-30s%s\n' 'generated code' 'skipped (lib/ is dirty)'
  else
    run 'generated code' \
      'dart run build_runner build && flutter gen-l10n' \
      sh -c 'dart run build_runner build >/dev/null 2>&1 &&
             flutter gen-l10n >/dev/null 2>&1 &&
             git diff --exit-code --stat -- lib'
  fi
fi

[ -z "$failed" ] && run 'tests' 'flutter test' flutter test

if [ -n "$failed" ]; then
  printf '\n  Nothing was pushed.\n'
  printf '  Reproduce: %s\n' "$failed"
  printf '  Push anyway: git push --no-verify\n\n'
  exit 1
fi

printf '\n  All checks passed.\n\n'
